APP_NAME="Agentic AI Incident Investigation Platform"
APP_ENV=local
RAG_TOP_K=5
RISK_THRESHOLD_HIGH=75
RISK_THRESHOLD_MEDIUM=45
DATABASE_URL=postgresql://incident:incident@localhost:5432/incident_response
USE_POSTGRES=false
POSTGRES_HOST=localhost
POSTGRES_DB=incident_response
POSTGRES_USER=incident
POSTGRES_PASSWORD=incident
REDIS_URL=redis://localhost:6379/0
AUTH_REQUIRED=true
JWT_SECRET_KEY=change-me-local-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120
DEMO_USERNAME=analyst
DEMO_PASSWORD=analyst
LLM_PROVIDER=openai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIMENSIONS=384
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-3-5-haiku-latest
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_SECONDS=0.5
LLM_RETRY_MAX_SECONDS=4.0
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
EVALUATION_PROVIDER=auto
EVALUATION_MODEL=gpt-4o-mini
EVALUATION_MAX_RETRIES=2
A2A_PROVIDER=local
A2A_API_KEY=
A2A_AGENT_URLS={}
A2A_TIMEOUT_SECONDS=10
A2A_MAX_RETRIES=2

# ── AegisOps SRE platform ──────────────────────────────────────────────────
# LLM reasoning (optional). Empty keys => deterministic evidence scoring; app still starts.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GOOGLE_API_KEY=
# auto | off
AEGIS_LLM_MODE=auto
# true => CrewAI uses local Ollama when no API key
AEGIS_USE_OLLAMA=false
AEGIS_PUBLIC_URL=http://localhost:8000
# inprocess (single container) | network (specialists reachable at AEGIS_PUBLIC_URL)
AEGIS_A2A_MODE=inprocess
AEGIS_STATE_DIR=data/sre_state
# >0 enables built-in health/metric polling of registered apps
AEGIS_MONITOR_INTERVAL_SECONDS=0
# wait after remediation before verifying recovery
AEGIS_VERIFY_SETTLE_SECONDS=3
# Bearer token AegisOps sends to an app's remediation hooks: AEGIS_HOOK_TOKEN_<APP_NAME_UPPER>
AEGIS_HOOK_TOKEN_DEMO_TARGET=demo-admin-token
# ShopFront (shopfront/): ops token AegisOps sends to its hooks, and the demo fault-injection token
AEGIS_HOOK_TOKEN_SHOPFRONT=shopfront-ops-token
SHOPFRONT_FAULT_TOKEN=shopfront-fault-token
DEMO_ADMIN_TOKEN=demo-admin-token
# Observability: OTLP/HTTP traces (Jaeger, Tempo, or Langfuse's /api/public/otel endpoint)
OTEL_EXPORTER_OTLP_ENDPOINT=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
