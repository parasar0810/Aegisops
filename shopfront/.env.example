# Copy to .env and replace every value. Never commit .env.
SHOPFRONT_DB_PASSWORD=change-me-db-password
# Token AegisOps sends to ShopFront's allowlisted remediation hooks (same value in AegisOps).
AEGIS_HOOK_TOKEN_SHOPFRONT=change-me-ops-token
# Demo fault injection: disabled unless true; protected by this token.
SHOPFRONT_FAULTS_ENABLED=false
SHOPFRONT_FAULT_TOKEN=change-me-fault-token
SHOPFRONT_BUILD_TIME=0
